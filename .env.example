# AI Core Database (Default: SQLite, or provide PostgreSQL URL)
# DATABASE_URL=postgresql://user:password@localhost:5432/ecommerce_db
DATABASE_URL=sqlite:///./chat_history.db

# Google Gemini API Key (Get yours from Google AI Studio: https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=your_gemini_api_key_here

# Telegram Bot Token (Get yours from @BotFather on Telegram)
BOT_TOKEN=your_telegram_bot_token_here

# AI Core API URL
AI_CORE_URL=http://127.0.0.1:8000
